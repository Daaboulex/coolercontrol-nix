+    #[allow(clippy::cast_sign_loss, clippy::cast_possible_truncation)]
+    fn mac_smc_rpm_from_duty(fan: &AppleFanInfo, duty: Duty) -> RPM {
+        if duty == 0 {
+            return MAC_SMC_FIRMWARE_TARGET;
+        }
+        let span = f64::from(fan.max_rpm.saturating_sub(fan.default_min_rpm));
+        let rpm = f64::from(fan.default_min_rpm) + span * f64::from(duty.min(100)) / 100.;
+        (rpm.round() as RPM).max(fan.default_min_rpm).min(fan.max_rpm)
+    }
+
+    fn mac_smc_duty_from_rpm(fan: &AppleFanInfo, rpm: RPM) -> f64 {
+        if rpm <= fan.default_min_rpm {
+            return 0.;
+        }
+        if rpm >= fan.max_rpm {
+            return 100.;
+        }
+        let span = f64::from(fan.max_rpm - fan.default_min_rpm);
+        (f64::from(rpm - fan.default_min_rpm) * 100. / span).round()
+    }
